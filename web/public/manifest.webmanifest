{
  "name": "AuraHUD",
  "short_name": "AuraHUD",
  "description": "Private life HUD — capture in seconds, Cloud AI off",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "background_color": "#070709",
  "theme_color": "#070709",
